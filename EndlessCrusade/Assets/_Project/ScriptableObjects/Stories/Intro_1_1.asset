  m_Script: {fileID: 11500000, guid: 32a982e1ed9c1437b944e2f4ddf39174, type: 3}
  m_Name: Intro_1_1
  m_EditorClassIdentifier: 
  id: story_1_1_intro
  panels:
  - text: "El Templario se ha retirado a una caba\xF1a en las afueras, lejos de las
      \xF3rdenes y de las guerras."
    image: {fileID: 0}
  - text: Esa noche estalla una tormenta. La lluvia golpea el techo sin descanso.
    image: {fileID: 0}
  - text: "El Templario bebe hasta perder la noci\xF3n del tiempo."
    image: {fileID: 0}
  - text: "Algo irrumpe en la oscuridad. La puerta cae y se llevan al Beb\xE9 de
      la Profec\xEDa."
    image: {fileID: 0}
  - text: Despierta entre los restos de la puerta destruida. Debe defender las ruinas.
    image: {fileID: 0}
